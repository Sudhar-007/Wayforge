# Copy this file to .env and fill in your actual keys.
# .env is gitignored — never commit it.

# Gemini API key — get it from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Serper API key — get it from https://serper.dev/dashboard
SERPER_API_KEY=your-serper-api-key-here

# Optional: override the default Gemini model.
# Default (when unset) is gemini-3.1-flash-lite. Do NOT downgrade to 2.0.
# GEMINI_MODEL=gemini-3.1-flash-lite

# GitHub OAuth App credentials — https://github.com/settings/developers
# The OAuth App's callback must be set to {BACKEND_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret used to sign session JWTs (HS256). Use a long random string.
JWT_SECRET=

# Where the frontend runs — the OAuth callback redirects here with the token.
FRONTEND_URL=http://localhost:5173

# Optional: public base URL of this backend (used to build the OAuth callback).
# Defaults to http://localhost:8000 when unset.
# BACKEND_URL=http://localhost:8000
